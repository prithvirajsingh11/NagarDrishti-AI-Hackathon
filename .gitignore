# ==============================================================================
# NagarDrishti AI - Root .gitignore
# Consolidated Submission Repository
# ==============================================================================

# Environment variables & credentials
.env
.env.local
.env.*
*.env
# Preserve example files
!.env.example
!*.env.example
!.env.*.example

# Node & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build & Bundler Outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
coverage/
**/coverage/
*.local

# Python Environments & Bytecode
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
.Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so
.pytest_cache/
**/.pytest_cache/
develop-eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Runtime & Local Data Uploads
uploads/
**/uploads/
logs/
**/logs/
*.log

# Mobile / Android Build Artifacts
android/app/build/
android/.gradle/
android/local.properties
**/android/app/build/
**/android/.gradle/
**/android/local.properties
capacitor.config.json.backup

# Operating System & IDE Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Preserve VS Code recommended settings / extensions
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
