# ==============================================================================
# NagarDrishti AI - Backend Environment Configuration Template
# ==============================================================================
PROJECT_NAME="NagarDrishti AI"
API_V1_PREFIX="/api"

# AI Provider Configuration ("gemini" | "local" | "mock")
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_CONFIDENCE_THRESHOLD=0.75

# Supabase PostgreSQL & Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# service_role secret key strictly on the FastAPI backend (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
STORAGE_BUCKET=complaint-images

# Local fallback image upload dir
UPLOAD_DIR=uploads

# CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
