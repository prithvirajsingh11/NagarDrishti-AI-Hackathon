# ==============================================================================
# NagarDrishti AI - Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' in both project root and backend directory.
# NEVER commit real production API keys or credentials to Git repositories.

# Application Information
PROJECT_NAME="NagarDrishti AI"
API_V1_PREFIX="/api"

# AI Provider Configuration
# Supported options: "gemini" | "local" | "mock"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.75

# Supabase PostgreSQL & Storage Configuration
# Find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key strictly on the FastAPI backend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
STORAGE_BUCKET=complaint-images