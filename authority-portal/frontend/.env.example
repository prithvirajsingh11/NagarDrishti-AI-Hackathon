# NagarDrishti AI Authority Portal - Environment Configuration
# Base URL for the shared FastAPI backend.
# In local development: http://localhost:8000 (or leave empty to use Vite proxy /api).
# In production: Set either VITE_API_BASE_URL or VITE_API_URL to your deployed backend (e.g., https://api.nagardrishti.org)
VITE_API_BASE_URL=http://localhost:8000
# VITE_API_URL=https://api.nagardrishti.org

# Supabase Project Configuration (Same project as Citizen Application)
# Safe client-side anonymous configuration. NEVER commit the service role key!
VITE_SUPABASE_URL=https://otjbonkovzciglttxfzz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
