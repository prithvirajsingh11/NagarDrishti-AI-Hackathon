# NagarDrishti AI Backend Environment Variables
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
# In production, specify allowed frontend origins (comma-separated, NO trailing slashes)
CORS_ORIGINS=https://nagardrishti-authority.vercel.app,https://nagardrishti-citizen.vercel.app,http://localhost:5173,http://localhost:5174

# Supabase Service Role (Server-Side ONLY - Never expose in frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STORAGE_BUCKET=complaint-images
